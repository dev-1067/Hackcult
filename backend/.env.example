# Copy to backend/.env and adjust. Every value has a working default for local use.

# Database: SQLite file by default (WAL mode + FTS5 trigram search).
# DATABASE_URL=sqlite:///data/lipisetu.db

# REQUIRED in production: a long random secret for signing sign-in tokens.
# JWT_SECRET=change-me-to-a-long-random-string

# Allowed browser origins for the API (only needed when the frontend runs on another origin).
# CORS_ORIGINS=http://localhost:5173

# Run the OCR worker inside the API process (true) or as separate `python -m app.worker` processes (false).
# EMBEDDED_WORKER=true

# Optional: enables the Claude vision OCR engine and line translation.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Optional: path to tesseract.exe if installed somewhere unusual (adds Gujarati and a Sanskrit model).
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Road routing for heritage trails (falls back to straight-line estimates if unreachable).
# OSRM_URL=https://router.project-osrm.org
